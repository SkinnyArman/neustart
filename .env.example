# --- OpenAI (only used to read the ad and draft the reply) ---
OPENAI_API_KEY=sk-...

# Recommended: strong writing, ~$0.01 per ad drafted.
OPENAI_MODEL=gpt-5.6-terra
# Budget alternative (~10x cheaper): gpt-5.6-luna
# Max quality (~2x pricier):         gpt-5.6-sol

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Where ads get posted. Your own chat id, or a GROUP id (negative).
TELEGRAM_CHAT_ID=123456789
# Who may command the bot. Required when CHAT_ID is a group, because every
# member can see the buttons - this is checked per user, not per chat.
TELEGRAM_OWNER_ID=123456789

# For LinkedIn from your own computer (npm run linkedin): the Worker's address
# and a secret it shares with the Worker (npx wrangler secret put INGEST_SECRET)
NEUSTART_URL=https://<worker>.workers.dev
INGEST_SECRET=pick-anything-long-and-random

# npm run setup reads these, asks for any that are missing, and adds
# WEBHOOK_SECRET itself. Everything else - the city, who's searching, the
# room profile - is in neustart.yaml. Timing (check interval, ads per hour)
# can also be changed from Telegram with /settings.
